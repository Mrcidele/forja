{
    "preset": "psr12",
    "exclude": [
        "var"
    ],
    "rules": {
        "declare_strict_types": true,
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha",
            "imports_order": [
                "class",
                "function",
                "const"
            ]
        },
        "array_syntax": {
            "syntax": "short"
        },
        "single_quote": true,
        "trailing_comma_in_multiline": {
            "elements": [
                "arrays",
                "arguments",
                "parameters",
                "match"
            ]
        }
    }
}
